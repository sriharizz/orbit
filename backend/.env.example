AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Bedrock Model ID
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# DynamoDB (set to false when table is created in AWS)
USE_LOCAL_DB=true
DYNAMO_TABLE_NAME=StudentProgress

# S3 + RAG (Knowledge Bases)
S3_BUCKET=orbit-transcripts-2026
KNOWLEDGE_BASE_ID=your_knowledge_base_id_here

# Bedrock Guardrails
GUARDRAIL_ID=your_guardrail_id_here
GUARDRAIL_VERSION=DRAFT
